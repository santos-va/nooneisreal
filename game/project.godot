[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighter_body"
3d_physics/layer_3="hurtbox"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="ragdoll"
3d_physics/layer_6="grapple_anchor"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.09, 0.08, 0.11, 1)
